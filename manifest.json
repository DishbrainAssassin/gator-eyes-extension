{
  "manifest_version": 3,
  "name": "Gator Eyes for Cardano",
  "version": "1.2.0",
  "description": "Free Gator Eyes flow panel and Ask Quagmire on Solada.fun and Snek.fun coin pages, plus a Gator Run Downs tab for free picks.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://gator-eyes.nlunn6731.workers.dev/*",
    "https://gatorrundowns.fun/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gator Eyes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.solada.fun/*",
        "https://solada.fun/*",
        "https://www.snek.fun/*",
        "https://snek.fun/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://www.gatoreyes.fun/",
  "optional_permissions": [
    "notifications"
  ]
}
